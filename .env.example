# Copy to .env and change every password before this is reachable by anyone else.
# .env is gitignored; .env.example is committed.

# --- database -------------------------------------------------------------
STOCKI_DB_NAME=stocki
STOCKI_DB_USER=stocki
STOCKI_DB_PASSWORD=stocki

# The role the API connects as: SELECT only, created during `stocki ingest`.
STOCKI_RO_USER=stocki_ro
STOCKI_RO_PASSWORD=stocki_ro

# --- host ports -----------------------------------------------------------
# Where docker-compose.override.yml publishes Postgres for host-side training.
# stocki.config defaults to 5434 when nothing is set.
STOCKI_HOST_DB_PORT=5434
STOCKI_API_PORT=8000

# --- api ------------------------------------------------------------------
# Never "*". List the dashboard origins explicitly.
STOCKI_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
STOCKI_RATE_LIMIT=120
STOCKI_DATASET_RATE_LIMIT=20
