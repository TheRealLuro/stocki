# Copy to .env and change every password before this is reachable by anyone else.
# .env is gitignored; .env.example is committed.

# --- database -------------------------------------------------------------
STOCKI_DB_NAME=stocki
STOCKI_DB_USER=stocki
STOCKI_DB_PASSWORD=stocki

# The role the API connects as: SELECT only, created during `stocki ingest`.
STOCKI_RO_USER=stocki_ro
STOCKI_RO_PASSWORD=stocki_ro

# --- host ports -----------------------------------------------------------
# Where docker-compose.override.yml publishes Postgres for host-side training.
# stocki.config defaults to 5434 when nothing is set.
STOCKI_HOST_DB_PORT=5434
STOCKI_API_PORT=8000

# --- api ------------------------------------------------------------------
# Never "*". List the dashboard origins explicitly.
STOCKI_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
STOCKI_RATE_LIMIT=120
STOCKI_DATASET_RATE_LIMIT=20

# --- live data (`stocki fetch`) -------------------------------------------
# An Alpha Vantage key. Free keys: https://www.alphavantage.co/support/#api-key
# Read from backend/.env. These names are checked in order, first one wins:
#   ALPHA_ADVANTAGE_KEY, ALPHAVANTAGE_API_KEY, ALPHA_VANTAGE_API_KEY,
#   STOCKI_ALPHAVANTAGE_KEY
ALPHA_ADVANTAGE_KEY=

# Company reports change quarterly, so they are cached this long. Keeping the
# cache warm is what makes a daily refresh cost ~11 requests instead of ~51.
STOCKI_LIVE_CACHE_HOURS=24
STOCKI_LIVE_CACHE_DIR=

# The free plan allows 25 requests/day at about 1/second. A run stops with a
# message rather than half-writing a dataset when the budget is spent.
STOCKI_LIVE_REQUEST_BUDGET=25
STOCKI_LIVE_MIN_INTERVAL=1.5
